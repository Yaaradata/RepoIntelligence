# RepoIntelligence V1 — environment
#
# Secrets and deployment details only. Tunables live in config/settings.yaml
# so that a threshold change shows up in a diff and in review.
#
# Any settings.yaml value can still be overridden here as SECTION_KEY
# (e.g. ELIGIBILITY_MIN_STARS=25). An unrecognised SECTION_KEY aborts the run.

# ── Secrets ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@host:5432/dbname
# Fine-grained PAT, public-repo read only. No write scopes.
# Settings → Developer settings → Personal access tokens → Fine-grained.
GITHUB_TOKEN=github_pat_xxxxxxxxxxxx
# Phase 2+. Leave unset until the screen and editorial stages exist.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx

# NO AWS keys here. SES uses the EC2 instance role.

# ── Database ───────────────────────────────────────────────────────────
DB_SCHEMA=repo_intelligence

# ── Rate limits ────────────────────────────────────────────────────────
# Deployment-specific: one box's safe pace is not another's.
GITHUB_RATE_SLEEP=0.8            # core REST is 5,000/hr authenticated
GITHUB_SEARCH_SLEEP=2.5          # search is 30/min — much stricter
HN_RATE_SLEEP=0.3
REGISTRY_RATE_SLEEP=1.0

# A contactable address is expected by npm and PyPI; a bare tool name
# risks being throttled.
HTTP_USER_AGENT=RepoIntelligenceV1 (TheNeural newsletter; contact you@domain.com)

# ── API bases — override only to point at a mock or a proxy ───────────
# GITHUB_API_BASE=https://api.github.com
# HN_API_BASE=https://hn.algolia.com/api/v1
# NPM_API_BASE=https://api.npmjs.org
# NPM_REGISTRY_BASE=https://registry.npmjs.org
# PYPI_STATS_BASE=https://pypistats.org/api
# PYPI_JSON_BASE=https://pypi.org/pypi
# CRATES_API_BASE=https://crates.io/api/v1
# DOCKERHUB_API_BASE=https://hub.docker.com/v2

# ── Email (health report) — Phase 4 ───────────────────────────────────
# SES_REGION=ap-south-1
# SES_FROM=pipeline@yourdomain.com
# ALERT_RECIPIENTS=you@domain.com,manager@domain.com
