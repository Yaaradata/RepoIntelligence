# ── Database ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@host:5432/dbname
DB_SCHEMA=repo_intelligence

# ── GitHub ─────────────────────────────────────────────────────────────
# Fine-grained PAT, public-repo read only. Settings → Developer settings
# → Personal access tokens → Fine-grained. No write scopes needed.
GITHUB_TOKEN=github_pat_xxxxxxxxxxxx
GITHUB_API_BASE=https://api.github.com
GITHUB_RATE_SLEEP=0.8            # seconds between calls; 5000/hr authenticated
GITHUB_SEARCH_SLEEP=2.5          # search API is 30/min — much stricter

# ── Hacker News (Algolia) — no key required ───────────────────────────
HN_API_BASE=https://hn.algolia.com/api/v1
HN_RATE_SLEEP=0.3

# ── Package registries — no keys required ─────────────────────────────
NPM_API_BASE=https://api.npmjs.org
NPM_REGISTRY_BASE=https://registry.npmjs.org
PYPI_STATS_BASE=https://pypistats.org/api
PYPI_JSON_BASE=https://pypi.org/pypi
CRATES_API_BASE=https://crates.io/api/v1
DOCKERHUB_API_BASE=https://hub.docker.com/v2
REGISTRY_RATE_SLEEP=1.0
HTTP_USER_AGENT=RepoIntelligenceV1 (TheNeural newsletter; contact you@domain.com)

# ── LLM (OpenRouter only) ──────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
SCREEN_MODEL=z-ai/glm-5.3-flash
DIGEST_MODEL=z-ai/glm-5.3-flash
EDITORIAL_MODEL=openai/gpt-5.6-sol
SELECTION_MODEL=openai/gpt-5.6-sol
SCREEN_BATCH_SIZE=10
EDITORIAL_BATCH_SIZE=5
LLM_CONCURRENCY=4

# ── Budget ─────────────────────────────────────────────────────────────
MAX_COST_USD=10                  # cumulative cap per pipeline run
DAILY_SPEND_CAP=3
MONTHLY_SPEND_CAP=40

# ── Thresholds (all overridable) ───────────────────────────────────────
MIN_STARS_NEW_LANE=3
MIN_STARS_ELIGIBLE=10
MIN_CONTRIBUTORS_ELIGIBLE=3
MIN_SHOWHN_POINTS_ELIGIBLE=50
MIN_DOWNLOADS_ELIGIBLE=1000
POPULAR_LANE_MIN_STARS=2000
POPULAR_LANE_MIN_DOWNLOADS=50000
MOMENTUM_Z_THRESHOLD=2.0
MOMENTUM_MIN_ABS_DELTA=15
BAYES_PRIOR_K=5
EDITORIAL_TOP_N=40
COOLDOWN_DAYS=90

# ── Email (health report) ──────────────────────────────────────────────
SES_REGION=ap-south-1
SES_FROM=pipeline@yourdomain.com
ALERT_RECIPIENTS=you@domain.com,manager@domain.com
# SES uses the EC2 instance role — NO static AWS keys in .env
